/* Master-detail layout */
UserPage {
    layout: horizontal;
    height: 1fr;
}

UserListSection {
    width: 40%;
    height: 100%;
    padding: 1;
}

UserListSection DataTable {
    height: 1fr;
}

UserDetailSection {
    width: 60%;
    height: 100%;
    padding: 1;
    overflow-y: auto;
}

/* Hidden utility */
.hidden {
    display: none;
}

/* AddUserBar */
AddUserBar {
    height: auto;
    layout: horizontal;
    padding: 0 0 1 0;
}

AddUserBar Input {
    width: 1fr;
}

AddUserBar Button {
    margin-left: 1;
}

/* Detail placeholder */
#detail-placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

#detail-content {
    height: auto;
}

/* Fetch bar */
#fetch-bar {
    height: auto;
    layout: horizontal;
}

#fetch-bar Input {
    width: 1fr;
}

#fetch-bar Button {
    margin-left: 1;
}

#fetch-button {
    width: auto;
}

/* FetchArtists progress */
FetchArtists {
    width: auto;
    height: 8;
    border: solid grey;
}

#fetch-counter {
    text-align: right;
    width: 100%;
}

#fetch-log {
    overflow-x: hidden;
    max-height: 4;
    height: 4;
}

/* Settings */
.setting-label {
    margin-top: 1;
    text-style: bold;
}

#min-scrobbles-input,
#releases-not-before-input {
    width: 100%;
}
#submit-form {
    align: right middle;
}


/* Confirm-delete modal */
ConfirmDeleteScreen {
    align: center middle;
}

#confirm-dialog {
    width: 40;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#confirm-question {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#confirm-buttons {
    width: 100%;
    height: auto;
    align-horizontal: center;
}

#confirm-buttons Button {
    margin: 0 1;
}
