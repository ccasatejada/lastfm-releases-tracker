ReleasePage {
    layout: horizontal;
    height: 1fr;
}

ReleaseListSection {
    width: 55%;
    height: 100%;
    padding: 1;
}

ReleaseListSection DataTable {
    height: 1fr;
}

ReleaseDetailSection {
    width: 45%;
    height: 100%;
    padding: 1;
    overflow-y: auto;
}

#detail-placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

#release-cover {
    width: 100%;
    height: 10;
}

#no-cover-placeholder {
    width: 100%;
    height: 10;
    content-align: center middle;
    border: solid $panel;
    color: $text-muted;
}

#release-artist {
    text-style: bold;
    width: 1fr;
}

#release-title {
    width: 1fr;
}

#user-release-table {
    height: auto;
    max-height: 40%;
}

.section-title {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}
